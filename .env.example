# PDS Web Analytics — Environment Variables
#
# Copy this file to .env and fill in real values for local production runs.
# In ECS, these are injected via the task definition — do not commit .env.
#
# Required
S3_BUCKET_NAME=
S3_CF_BUCKET_NAME=
OPENSEARCH_URL=
INDEX_PREFIX=
AWS_REGION=us-west-2

# Optional — used for local AWS CLI auth; not needed in ECS (uses IAM task role)
# AWS_PROFILE=
