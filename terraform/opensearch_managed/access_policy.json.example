[
  {
    "Sid": "AllowEC2Role",
    "Effect": "Allow",
    "Principal": [
      "arn:aws:iam::{account_id}:role/<your-ec2-instance-role-name>"
    ],
    "Action": ["es:*"],
    "Resource": [
      "arn:aws:es:{region}:{account_id}:domain/{domain_name}",
      "arn:aws:es:{region}:{account_id}:domain/{domain_name}/*"
    ]
  }
]

NOTE: For test/prod, add a second statement to allow platform engineers to
use the OpenSearch UI Dev Console. Only include this if the role exists in
the account — AWS will reject the policy if the principal does not exist.

  {
    "Sid": "AllowPlatformEngineer",
    "Effect": "Allow",
    "Principal": [
      "arn:aws:iam::{account_id}:role/{venue}-en-platform-engineer"
    ],
    "Action": ["es:ESHttp*"],
    "Resource": [
      "arn:aws:es:{region}:{account_id}:domain/{domain_name}/*"
    ]
  }
