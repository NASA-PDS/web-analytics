# Infra values shared by root + IAM modules for a given venue.
# Copy to common-infra-<venue>.tfvars and fill in the values before applying.
# These differ per venue (dev vs prod) so are NOT part of common.tfvars.
# Used by root and IAM tasks; NOT passed to opensearch_managed.

partition              = "aws"
s3_bucket_prefix       = ""  # e.g. pds-dev-gh01dc — S3 bucket name only, may include CI/CD identifiers
resource_prefix        = ""  # e.g. pds-dev — prefix for IAM policy names and all non-S3 resources
ec2_role_name          = ""  # e.g. pds-mcp-ec2-instance-role
opensearch_domain_name = ""  # e.g. pds-dev-web-analytics
